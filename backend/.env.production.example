# Copy this file to backend/.env.production and fill in real values before
# running: docker compose -f docker-compose.prod.yml up -d --build
# This single file is used as env_file by the backend, worker, and postgres
# services in docker-compose.prod.yml. pgAdmin is intentionally NOT run in
# production — use `docker compose exec postgres psql ...` or a local
# pgAdmin/DBeaver over an SSH tunnel instead.

NODE_ENV=production

# --- App secrets ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RESET_SECRET=
ENCRYPTION_KEY=
QR_PEPPER_SECRET=
OTP_PEPPER_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of the frontend (used in emails, CORS, etc.)
FRONTEND_URL=https://yourdomain.com

# --- Database (points at the `postgres` service in docker-compose.prod.yml) ---
POSTGRES_DB=rentflow
POSTGRES_USER=rentflow
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rentflow:CHANGE_ME@postgres:5432/rentflow

# --- Redis (points at the `redis` service) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- OCR microservice (points at the `ocr-service` service) ---
OCR_SERVICE_URL=http://ocr-service:8899

# --- Mail / SMTP ---
MAIL_USER=
MAIL_PASS=
SMTP_HOST=
SMTP_PORT=

# --- Cloudflare R2 / S3 ---
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN=
S3_BUCKET=

# --- SlipOK payment verification ---
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# --- OCR service pool size (tune to VPS RAM; each PaddleOCR instance ~300-500MB) ---
OCR_POOL_SIZE=3
