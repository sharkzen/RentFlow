{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:server": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/workers/email.worker.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\"",
    "clean": "shx rm -rf dist",
    "prebuild": "npm run clean",
    "build:server": "esbuild src/server.ts --bundle --platform=node --external:argon2 --external:bull --external:sharp --external:figlet --outdir=dist",
    "build:worker": "esbuild src/workers/email.worker.ts --bundle --platform=node --external:bull --external:sharp --external:figlet --outdir=dist/workers",
    "copy:bull": "shx mkdir -p dist/lib && shx cp -r node_modules/bull/lib/* dist/lib/",
    "build": "npm run build:server && npm run build:worker && npm run copy:bull",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/workers/email.worker.js",
    "start": "concurrently \"npm run start:server\" \"npm run start:worker\""
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.956.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/client": "^6.19.1",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "dotenv": "^17.2.3",
    "esbuild-ts-paths": "^1.1.3",
    "express": "^5.2.1",
    "fastify": "^5.6.2",
    "fastify-multipart": "^5.3.1",
    "figlet": "^1.8.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.12",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "promptpay-qr": "^0.5.0",
    "puppeteer": "^24.35.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "prisma": "^6.19.1",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
