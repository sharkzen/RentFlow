generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id             String              @id @default(uuid())
  tenantId       String?
  ownerId        String?
  bucket         String
  dormitoryId    String?
  roomId         String?
  paymentId      String?
  maintenanceId  String?
  category       FileCategory
  objectKey      String
  mimeType       String
  size           Int
  order          Int?
  isCover        Boolean             @default(false)
  createdAt      DateTime            @default(now())
  announcementId String?
  billingOrderId String?
  billingOrder   BillingOrder?       @relation("BillingOrderSlips", fields: [billingOrderId], references: [id])
  announcement   Announcement?       @relation("AnnouncementImages", fields: [announcementId], references: [id])
  dormitory      Dormitory?          @relation("DormitoryImages", fields: [dormitoryId], references: [id])
  maintenance    MaintenanceRequest? @relation("MaintenanceImages", fields: [maintenanceId], references: [id])
  payment        Payment?            @relation("PaymentSlips", fields: [paymentId], references: [id])
  room           Room?               @relation("RoomImages", fields: [roomId], references: [id])

  @@index([dormitoryId])
  @@index([roomId])
  @@index([paymentId])
  @@index([maintenanceId])
  @@index([announcementId])
  @@index([billingOrderId])
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  role                UserRole
  deletedAt           DateTime?
  status              Status             @default(PENDING)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  privacyConsentAt      DateTime?
  privacyConsentVersion String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  ownerProfile        OwnerProfile?
  tenantProfiles      TenantProfile[]
  passwordResetOtps   PasswordResetOtp[]
}

model OwnerProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  status      OwnerStatus @default(PENDING)
  fullName    String
  lineId      String?
  phone       String?
  facebook    String?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  dormitories Dormitory[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription  Subscription?
  billingOrders BillingOrder[]
  slipUsages    SlipUsage[]
  trialUsedAt   DateTime?
}

model Dormitory {
  id                  String               @id @default(uuid())
  ownerId             String
  name                String
  slug                String               @unique
  description         Json?
  address             String
  lineId              String?
  lineType            LineType             @default(PERSONAL)
  facebook            String?
  latitude            Float
  longitude           Float
  mapUrl              String
  status              Status               @default(PENDING)
  isPublished         Boolean              @default(false)
  isFeatured          Boolean              @default(false)
  featuredOrder       Int?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  announcements       Announcement[]
  billDrafts          BillDraft[]
  owner               OwnerProfile         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  settings            DormitorySetting?
  images              File[]               @relation("DormitoryImages")
  maintenanceRequests MaintenanceRequest[]
  paymentSetting      PaymentSetting?
  rooms               Room[]
  contacts            DormitoryContact[]
  promotions          DormPromotion[]
  billingOrders       BillingOrder[]

  @@index([ownerId])
  @@index([isFeatured, featuredOrder])
}

model DormitorySetting {
  id               String           @id @default(uuid())
  dormitoryId      String           @unique
  roomPrice        Float?
  waterBillingType WaterBillingType @default(METERED)
  waterRate        Float
  electricRate     Float
  commonFee        Float            @default(0)
  lateFee          Float            @default(0)
  dueDay           Int
  dueMonthOffset   Int              @default(1)
  dormitory        Dormitory        @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
}

model PaymentSetting {
  id             String         @id @default(uuid())
  dormitoryId    String         @unique
  promptPayType  PromptPayType?
  promptPayValue String?
  bankName       String?
  bankAccount    String?
  bankHolder     String?
  promptPayHolder String?
  isActive       Boolean        @default(true)
  dormitory      Dormitory      @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
}

model DormitoryContact {
  id          String    @id @default(uuid())
  dormitoryId String
  name        String?
  phone       String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  dormitory   Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@index([dormitoryId])
}

model Room {
  id                  String               @id @default(uuid())
  dormitoryId         String
  roomNumber          String
  floor               Int
  type                RoomType?
  description         String?
  basePrice           Float
  status              RoomStatus           @default(AVAILABLE)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  bills               Bill[]
  images              File[]               @relation("RoomImages")
  maintenanceRequests MaintenanceRequest[]
  dormitory           Dormitory            @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  tenants             TenantProfile[]

  meterSetting RoomMeterSetting?
  qrAuth       RoomQrAuth?

  @@unique([dormitoryId, roomNumber])
  @@index([dormitoryId])
}

model TenantProfile {
  id                    String                @id @default(uuid())
  userId                String
  roomId                String?
  firstName             String
  lastName              String
  phone                 String?
  email                 String?
  idCard                String?
  address               String?
  numberOfResidents     Int                   @default(1)
  tenantNameSnapshot    String?
  securityDeposit       Float                 @default(0)
  advancePayment        Float                 @default(0)
  entranceFee           Float                 @default(0)
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  moveInDate            DateTime?
  moveOutDate           DateTime?
  isActive              Boolean               @default(true)
  deletedAt             DateTime?
  notes                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  privacyConsentAt      DateTime?
  privacyConsentVersion String?
  createdAt             DateTime              @default(now())
  announcementReadLogs  AnnouncementReadLog[]
  bills                 Bill[]
  maintenanceRequests   MaintenanceRequest[]
  room                  Room?                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user                  User                  @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
}

model Bill {
  id                          String           @id @default(uuid())
  roomId                      String
  tenantId                    String
  tenantNameSnapshot          String
  roomNumberSnapshot          String
  roomPriceSnapshot           Float
  billingMonth                DateTime
  dueDate                     DateTime
  waterBillingTypeSnapshot    WaterBillingType @default(METERED)
  prevWaterUnitSnapshot       Float
  currentWaterUnitSnapshot    Float
  waterUsedSnapshot           Float
  waterRateSnapshot           Float
  waterFeeSnapshot            Float
  prevElectricUnitSnapshot    Float
  currentElectricUnitSnapshot Float
  electricUsedSnapshot        Float
  electricRateSnapshot        Float
  electricFeeSnapshot         Float
  waterImageKey               String?
  electricImageKey            String?
  commonFeeSnapshot           Float
  lateFeeSnapshot             Float
  total                       Float
  note                        String?
  status                      BillStatus       @default(PENDING)
  archived                    Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  lastNotifiedAt              DateTime?
  reminderSentAt              DateTime?
  room                        Room             @relation(fields: [roomId], references: [id])
  tenant                      TenantProfile    @relation(fields: [tenantId], references: [id])
  items                       BillItem[]
  payment                     Payment?

  @@unique([roomId, billingMonth])
  @@index([tenantId])
  @@index([status])
}

model BillItem {
  id        String       @id @default(uuid())
  billId    String
  name      String
  amount    Float
  type      BillItemType @default(CHARGE)
  createdAt DateTime     @default(now())
  bill      Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String         @id @default(uuid())
  billId         String         @unique
  status         PaymentStatus  @default(WAITING_VERIFY)
  verifiedBy     String?
  verifiedAt     DateTime?
  paymentMethod  PaymentMethod?
  transferRef    String?        @unique
  transferAmount Float?
  transferBank   String?
  senderName     String?
  paidAt         DateTime?
  updatedAt      DateTime       @default(now()) @updatedAt
  createdAt      DateTime       @default(now())
  slips          File[]         @relation("PaymentSlips")
  bill           Bill           @relation(fields: [billId], references: [id])

  @@index([status])
}

model MaintenanceRequest {
  id          String            @id @default(uuid())
  dormitoryId String
  roomId      String
  tenantId    String
  title       String
  description String
  status      MaintenanceStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  ownerNote   String?
  images      File[]            @relation("MaintenanceImages")
  dormitory   Dormitory         @relation(fields: [dormitoryId], references: [id])
  room        Room              @relation(fields: [roomId], references: [id])
  tenant      TenantProfile     @relation(fields: [tenantId], references: [id])
  messages    MaintenanceMessage[]

  @@index([dormitoryId])
  @@index([roomId])
  @@index([tenantId])
}

model MaintenanceMessage {
  id            String              @id @default(uuid())
  maintenanceId String
  senderRole    UserRole
  senderId      String
  message       String
  createdAt     DateTime            @default(now())
  editedAt      DateTime?
  maintenance   MaintenanceRequest  @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId, createdAt])
}

model Landmark {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  type      LandmarkType
  latitude  Float
  longitude Float
  mapUrl    String
  status    Status       @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model BillDraft {
  id           String    @id @default(uuid())
  dormitoryId  String
  name         String
  selectedDate DateTime
  items        Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  dormitory    Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@index([dormitoryId])
}

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String                @id @default(uuid())
  dormitoryId String
  title       String
  content     String
  type        AnnouncementType      @default(NORMAL)
  isActive    Boolean               @default(true)
  isEmailSent Boolean               @default(false)
  order       Int                   @default(0)
  isPinned    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  dormitory   Dormitory             @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  readLogs    AnnouncementReadLog[]
  images      File[]                @relation("AnnouncementImages")

  @@index([isPinned, order, createdAt])
  @@index([dormitoryId])
}

model AnnouncementReadLog {
  id             String        @id @default(uuid())
  announcementId String
  tenantId       String
  readAt         DateTime      @default(now())
  announcement   Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  tenant         TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([announcementId, tenantId])
}

enum UserRole {
  ADMIN
  OWNER
  TENANT
}

enum OwnerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  DISABLED
}

enum BillStatus {
  PENDING
  WAITING_FOR_VERIFICATION
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  WAITING_VERIFY
  VERIFIED
  REJECTED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FileCategory {
  DORMITORY
  ROOM
  PAYMENT_SLIP
  MAINTENANCE
  ANNOUNCEMENT
  BILLING_SLIP
}

enum Status {
  PENDING
  ACTIVE
  BANNED
  INACTIVE
}

enum BillItemType {
  CHARGE
  DISCOUNT
}

enum WaterBillingType {
  METERED
  FLAT_RATE
}

enum PromptPayType {
  PHONE
  ID_CARD
  E_WALLET
}

enum LineType {
  PERSONAL
  OFFICIAL
}

/// *
///  * =======================
///  * ROOM
///  * =======================
enum RoomType {
  AIR
  FAN
}

/// *
///  * =======================
///  * PAYMENT
///  * =======================
enum PaymentMethod {
  CASH
  TRANSFER
}

enum LandmarkType {
  UNIVERSITY
  SCHOOL
  HOSPITAL
  SHOPPING_MALL
  ARL
  OFFICE
  MARKET
  RESTAURANT
  SUPERMARKET
  TRANSPORT
  PARK
  GOVERNMENT
  OTHER
}

/// *
///  * =======================
///  * ANNOUNCEMENT
///  * =======================
enum AnnouncementType {
  NORMAL
  IMPORTANT
  URGENT
}

model RoomMeterSetting {
  id                  String   @id @default(uuid())
  roomId              String   @unique
  electricMeterDigits Int      @default(5)
  waterMeterDigits    Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoomQrAuth {
  id        String   @id @default(uuid())
  roomId    String   @unique
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELED
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  PLAN
  PROMOTION
  BOTH
}

enum BillingOrderType {
  PLAN
  PROMOTION
}

enum BillingOrderStatus {
  PENDING
  PENDING_REVIEW
  PAID
  REJECTED
  EXPIRED
}

enum DormPromotionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model Plan {
  id               String         @id @default(uuid())
  name             String
  description      String?
  priceMonthly     Float          @default(0)
  maxDorms         Int            @default(1)
  maxRooms         Int            @default(12)
  slipQuotaMonthly Int            @default(0)
  slipOverageRate  Float?
  allowTrial       Boolean        @default(true)
  isFree           Boolean        @default(false)
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
  orders           BillingOrder[]
}

model Subscription {
  id                 String             @id @default(uuid())
  ownerId            String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  owner              OwnerProfile       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  description    String?
  type           CouponType
  value          Float
  appliesTo      CouponScope        @default(BOTH)
  planIds        String[]
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  perOwnerLimit  Int                @default(1)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  redemptions    CouponRedemption[]
  orders         BillingOrder[]
}

model CouponRedemption {
  id        String       @id @default(uuid())
  couponId  String
  ownerId   String
  orderId   String       @unique
  createdAt DateTime     @default(now())
  coupon    Coupon       @relation(fields: [couponId], references: [id])
  order     BillingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, ownerId])
}

model BillingOrder {
  id             String             @id @default(uuid())
  ownerId        String
  type           BillingOrderType
  planId         String?
  dormId         String?
  months         Int                @default(1)
  baseAmount     Float
  discountAmount Float              @default(0)
  finalAmount    Float
  couponId       String?
  status         BillingOrderStatus @default(PENDING)
  transferRef    String?            @unique
  holdUntil      DateTime?
  note           String?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          OwnerProfile       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan           Plan?              @relation(fields: [planId], references: [id])
  dorm           Dormitory?         @relation(fields: [dormId], references: [id])
  coupon         Coupon?            @relation(fields: [couponId], references: [id])
  slips          File[]             @relation("BillingOrderSlips")
  redemption     CouponRedemption?
  promotion      DormPromotion?

  @@index([ownerId, status])
  @@index([type, status, holdUntil])
}

model DormPromotion {
  id        String              @id @default(uuid())
  dormId    String
  orderId   String              @unique
  startsAt  DateTime
  endsAt    DateTime
  rankAt    DateTime
  status    DormPromotionStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  dorm      Dormitory           @relation(fields: [dormId], references: [id], onDelete: Cascade)
  order     BillingOrder        @relation(fields: [orderId], references: [id])

  @@index([status, endsAt])
  @@index([dormId, status])
}

model SlipUsage {
  id      String       @id @default(uuid())
  ownerId String
  period  String
  count   Int          @default(0)
  owner   OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, period])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
